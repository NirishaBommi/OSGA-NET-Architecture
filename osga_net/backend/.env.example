# OSGA-Net Workstation Environment Configuration
PROJECT_NAME="OSGA-Net Bone Age Workstation"
DATABASE_URL="sqlite:///./backend/data/osga.db"
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production"
MAX_UPLOAD_MB=15

# Path to trained PyTorch checkpoint (.pt)
CKPT_PATH="./runs/osga/best.pt"

# Path to directory containing evaluation runs
RUNS_DIR="./runs"

# Path to collected results json
RESULTS_JSON="./results/results.json"
